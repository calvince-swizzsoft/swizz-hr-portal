# Browser requests go through the Vite development proxy.
VITE_DATA_SOURCE=erp
VITE_API_BASE_URL=/api
# WebApplication1's configured IIS Express address. Override for your environment.
API_PROXY_TARGET=http://localhost:58240
# Optional Supabase project (Project Settings > API Keys). Use the publishable key only, never a secret/service_role key.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
# Use VITE_DATA_SOURCE=supabase for authenticated synthetic development scenarios.
# Both sources use the same portalClient contract. No fallback between sources.
